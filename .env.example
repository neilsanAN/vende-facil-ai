# Ambiente local. Não use estes valores em produção.
NODE_ENV=development
APP_URL=http://localhost:3000
# Em produção no Render: APP_URL da API + CORS do app Expo web
# APP_URL=https://vende-facil-api.onrender.com
# CORS_ORIGINS=https://vende-facil-app.onrender.com
CORS_ORIGINS=
DATABASE_URL=postgresql://vendefacil:vendefacil@localhost:5432/vendefacil
# 32 bytes em hexadecimal. A chave de exemplo é recusada quando NODE_ENV=production.
ENCRYPTION_KEY=0123456789abcdeffedcba98765432100123456789abcdeffedcba9876543210

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage

# R2 / S3. Obrigatório apenas quando STORAGE_DRIVER=r2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PRIVATE=vendefacil-private
R2_BUCKET_PUBLIC=vendefacil-public
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=

# Preferir Gemini para análise de imagem e texto de anúncio/roteiro.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_VISION_MODEL=gemini-3.6-flash

# Opcional: OpenAI como reserva (e TTS se não usar ElevenLabs).
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Provedor premium opcional de vídeo generativo. O modo padrão não depende dele.
VIDEO_GEN_API_URL=
VIDEO_GEN_API_KEY=
VIDEO_RENDERER=ffmpeg
FFMPEG_PATH=ffmpeg
FONT_PATH=

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# E-mail OTP (mesmo estilo Invento): preferir RESEND_API_KEY; senão SMTP_*
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_URL=
SMTP_SECURE=false
SMTP_FROM=VendeFacil AI <nao-responda@localhost>
MAIL_FROM=

# Cria um administrador da plataforma no seed. Sem estes valores, ninguém vira admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TRUST_PROXY=false
MAX_IMAGE_BYTES=10485760
MAX_AUDIO_BYTES=15728640
MAX_VIDEO_BYTES=104857600
