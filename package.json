{
  "name": "vendefacil",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "vitest run",
    "test:integration": "vitest run packages/business/src/tenant.integration.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "dotenv -e .env -- prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "db:deploy": "dotenv -e .env -- prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "db:seed": "dotenv -e .env -- tsx packages/database/prisma/seed.ts",
    "db:diff": "prisma migrate diff --from-empty --to-schema-datamodel packages/database/prisma/schema.prisma --script"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "dotenv-cli": "^8.0.0",
    "embedded-postgres": "19.0.0-beta.20",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "prisma": "^6.6.0",
    "tsx": "^4.19.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.9"
  }
}
