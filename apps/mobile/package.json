    "babel-preset-expo": "~13.0.0",
    "expo": "~53.0.9",
    "expo-constants": "~17.1.6",
    "expo-image-picker": "~16.1.4",
    "expo-linking": "~7.1.5",
    "expo-router": "~5.0.7",
    "expo-secure-store": "~14.2.3",
